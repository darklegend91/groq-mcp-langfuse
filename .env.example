GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Only needed for remote MCP. Must be public HTTPS.
MCP_PUBLIC_URL=https://your-host.example.com/mcp-server/mcp

# Optional Langfuse tracing (get keys from your Langfuse project settings).
# Use https://us.cloud.langfuse.com for the US region or your self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
